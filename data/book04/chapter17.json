  "passageAudio": [
    {
      "passageIndex": 0,
      "mandarin": {
        "file": "audio/book04/chapter17/b04_ch17_p01_m.mp3",
        "durationMs": 137736,
        "sentences": [
          {
            "index": 0,
            "paragraph": 0,
            "startMs": 0,
            "endMs": 4080,
            "text": "三上 ：陶罐和鐵罐 （第五十六頁）",
            "textSimplified": "三上 ：陶罐和铁罐 （第五十六页）"
          },
          {
            "index": 1,
            "paragraph": 2,
            "startMs": 4080,
            "endMs": 9864,
            "text": "國王的廚房裏有兩個罐子，一個是陶的，一個是鐵的。",
            "textSimplified": "国王的厨房里有两个罐子，一个是陶的，一个是铁的。"
          },
          {
            "index": 2,
            "paragraph": 2,
            "startMs": 9864,
            "endMs": 14352,
            "text": "驕傲的鐵罐看不起陶罐，常常奚落它。",
            "textSimplified": "骄傲的铁罐看不起陶罐，常常奚落它。"
          },
          {
            "index": 3,
            "paragraph": 4,
            "startMs": 14352,
            "endMs": 17160,
            "text": "『你敢碰我嗎，陶罐子？』",
            "textSimplified": "『你敢碰我吗，陶罐子？』"
          },
          {
            "index": 4,
            "paragraph": 4,
            "startMs": 17160,
            "endMs": 19296,
            "text": "鐵罐傲慢地問。",
            "textSimplified": "铁罐傲慢地问。"
          },
          {
            "index": 5,
            "paragraph": 4,
            "startMs": 19296,
            "endMs": 21816,
            "text": "『不敢，鐵罐兄弟。』",
            "textSimplified": "『不敢，铁罐兄弟。』"
          },
          {
            "index": 6,
            "paragraph": 4,
            "startMs": 21816,
            "endMs": 24168,
            "text": "謙虛的陶罐回答。",
            "textSimplified": "谦虚的陶罐回答。"
          },
          {
            "index": 7,
            "paragraph": 4,
            "startMs": 24168,
            "endMs": 27696,
            "text": "『我就知道你不敢，懦弱的東西！』",
            "textSimplified": "『我就知道你不敢，懦弱的东西！』"
          },
          {
            "index": 8,
            "paragraph": 4,
            "startMs": 27696,
            "endMs": 31416,
            "text": "鐵罐說，帶着更加輕蔑的神氣。",
            "textSimplified": "铁罐说，带着更加轻蔑的神气。"
          },
          {
            "index": 9,
            "paragraph": 4,
            "startMs": 31416,
            "endMs": 35904,
            "text": "『我確實不敢碰你，但並不是因為懦弱。』",
            "textSimplified": "『我确实不敢碰你，但并不是因为懦弱。』"
          },
          {
            "index": 10,
            "paragraph": 4,
            "startMs": 35904,
            "endMs": 37968,
            "text": "陶罐爭辯說。",
            "textSimplified": "陶罐争辩说。"
          },
          {
            "index": 11,
            "paragraph": 4,
            "startMs": 37968,
            "endMs": 43200,
            "text": "『我們生來就是給人們盛東西的，並不是用來碰撞的。",
            "textSimplified": "『我们生来就是给人们盛东西的，并不是用来碰撞的。"
          },
          {
            "index": 12,
            "paragraph": 4,
            "startMs": 43200,
            "endMs": 46800,
            "text": "說到盛東西，我不見得比你差。",
            "textSimplified": "说到盛东西，我不见得比你差。"
          },
          {
            "index": 13,
            "paragraph": 4,
            "startMs": 46800,
            "endMs": 46800,
            "text": "。",
            "textSimplified": "。"
          },
          {
            "index": 14,
            "paragraph": 4,
            "startMs": 46800,
            "endMs": 46800,
            "text": "。",
            "textSimplified": "。"
          },
          {
            "index": 15,
            "paragraph": 4,
            "startMs": 46800,
            "endMs": 51600,
            "text": "⋯』『住嘴，』鐵罐惱怒了，『你怎麼敢同我相提並論！",
            "textSimplified": "⋯』『住嘴，』铁罐恼怒了，『你怎么敢同我相提并论！"
          },
          {
            "index": 16,
            "paragraph": 4,
            "startMs": 51600,
            "endMs": 56160,
            "text": "你等着吧，要不了多久，你就會砸成碎片。",
            "textSimplified": "你等着吧，要不了多久，你就会砸成碎片。"
          },
          {
            "index": 17,
            "paragraph": 4,
            "startMs": 56160,
            "endMs": 59616,
            "text": "我卻永遠在這裏，什麼也不怕。』",
            "textSimplified": "我却永远在这里，什么也不怕。』"
          },
          {
            "index": 18,
            "paragraph": 4,
            "startMs": 59616,
            "endMs": 66144,
            "text": "『何必這樣說呢，』陶罐說，『我們還是和睦相處吧，有什麼可吵的呢！』",
            "textSimplified": "『何必这样说呢，』陶罐说，『我们还是和睦相处吧，有什么可吵的呢！』"
          },
          {
            "index": 19,
            "paragraph": 4,
            "startMs": 66144,
            "endMs": 72648,
            "text": "鐵罐心裏想：『我們走着瞧吧，總有一天，我要把你碰成碎片。』",
            "textSimplified": "铁罐心里想：『我们走着瞧吧，总有一天，我要把你碰成碎片。』"
          },
          {
            "index": 20,
            "paragraph": 6,
            "startMs": 72648,
            "endMs": 77136,
            "text": "時間在流逝，世界上發生了許多事情。",
            "textSimplified": "时间在流逝，世界上发生了许多事情。"
          },
          {
            "index": 21,
            "paragraph": 6,
            "startMs": 77136,
            "endMs": 84600,
            "text": "宮殿倒塌了，兩個罐子遺落在荒涼的場地上，上面覆蓋了厚厚的塵土。",
            "textSimplified": "宫殿倒塌了，两个罐子遗落在荒凉的场地上，上面覆盖了厚厚的尘土。"
          },
          {
            "index": 22,
            "paragraph": 6,
            "startMs": 84600,
            "endMs": 89208,
            "text": "有一天，人們來到這裏，發現了那個陶罐。",
            "textSimplified": "有一天，人们来到这里，发现了那个陶罐。"
          },
          {
            "index": 23,
            "paragraph": 6,
            "startMs": 89208,
            "endMs": 91896,
            "text": "『喲，這裏有一個罐子！』",
            "textSimplified": "『哟，这里有一个罐子！』"
          },
          {
            "index": 24,
            "paragraph": 6,
            "startMs": 91896,
            "endMs": 94104,
            "text": "一個人驚訝地說。",
            "textSimplified": "一个人惊讶地说。"
          },
          {
            "index": 25,
            "paragraph": 6,
            "startMs": 94104,
            "endMs": 97464,
            "text": "其他的人也都高興地叫起來。",
            "textSimplified": "其他的人也都高兴地叫起来。"
          },
          {
            "index": 26,
            "paragraph": 6,
            "startMs": 97464,
            "endMs": 102072,
            "text": "捧起陶罐，倒出裏面的泥土，擦洗乾淨。",
            "textSimplified": "捧起陶罐，倒出里面的泥土，擦洗干净。"
          },
          {
            "index": 27,
            "paragraph": 6,
            "startMs": 102072,
            "endMs": 106584,
            "text": "它就像當年一樣光潔、樸素、美觀。",
            "textSimplified": "它就像当年一样光洁、朴素、美观。"
          },
          {
            "index": 28,
            "paragraph": 7,
            "startMs": 106584,
            "endMs": 108528,
            "text": "『多美的陶罐！』",
            "textSimplified": "『多美的陶罐！』"
          },
          {
            "index": 29,
            "paragraph": 7,
            "startMs": 108528,
            "endMs": 113160,
            "text": "一個人說，『這是古代的東西，很有價值。』",
            "textSimplified": "一个人说，『这是古代的东西，很有价值。』"
          },
          {
            "index": 30,
            "paragraph": 7,
            "startMs": 113160,
            "endMs": 114936,
            "text": "『謝謝你們！』",
            "textSimplified": "『谢谢你们！』"
          },
          {
            "index": 31,
            "paragraph": 7,
            "startMs": 114936,
            "endMs": 124248,
            "text": "陶罐興奮地說，『我的兄弟鐵罐就在我旁邊，請你們把它也挖出來吧，它也一定悶得夠受了。』",
            "textSimplified": "陶罐兴奋地说，『我的兄弟铁罐就在我旁边，请你们把它也挖出来吧，它也一定闷得够受了。』"
          },
          {
            "index": 32,
            "paragraph": 7,
            "startMs": 124248,
            "endMs": 131784,
            "text": "人們立即動手，翻來覆去，把土都掘遍了，但是連鐵罐的影子也沒見到。",
            "textSimplified": "人们立即动手，翻来覆去，把土都掘遍了，但是连铁罐的影子也没见到。"
          },
          {
            "index": 33,
            "paragraph": 9,
            "startMs": 131784,
            "endMs": 137736,
            "text": "它不知道在什麼年代已經完全氧化，腐蝕成一堆銹土了。",
            "textSimplified": "它不知道在什么年代已经完全氧化，腐蚀成一堆锈土了。"
          }
        ]
      },
      "cantonese": {
        "file": "audio/book04/chapter17/b04_ch17_p01_c.mp3",
